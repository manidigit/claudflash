        android:fillColor="#B4B8F5"
        android:pathData="M30,24 L78,24 L78,58 L30,58 Z" />
    <!-- front card, solid white -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M22,40 L84,40 L84,80 L22,80 Z" />
